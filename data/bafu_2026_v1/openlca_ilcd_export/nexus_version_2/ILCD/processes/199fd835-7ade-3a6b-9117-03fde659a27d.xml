            <name>
                <baseName xml:lang="en">Photovoltaic laminate, a-Si, at plant</baseName>
            </name>
            <classificationInformation>
                <common:classification>
                    <common:class level="0" classId="b8a28b38-bf75-30c6-a251-d3e13f59c89a">photovoltaic</common:class>
                    <common:class level="1" classId="47ce7012-b94f-349a-bd2e-c6500677d0f5">production of components</common:class>
                </common:classification>
            </classificationInformation>
            <common:generalComment xml:lang="en">Production of photovoltaic thin film laminates. Deposition of nine thin-film layers on the triple-junction cell. The laminates ASR128 produced at United Solar have a size of 2.3 m2. The weight is 2.7 kg per m2. The rated nominal power is about 148Wp per laminate. The efficiency is estimated here for newer products with 6.5% at the beginning of the life time. Degradation has to be taken into account with achieved yields.;
Synonyms: Solarmodul, PV-module, amorphous silicon; 
UUID: 199fd835-7ade-3a6b-9117-03fde659a27d</common:generalComment>
        </dataSetInformation>
        <quantitativeReference type="Reference flow(s)">
            <referenceToReferenceFlow>1</referenceToReferenceFlow>
        </quantitativeReference>
