    <processInformation>
        <dataSetInformation>
            <common:UUID>d0a5ab89-9134-36c5-a56a-bf1f83c204ae</common:UUID>
            <name>
                <baseName xml:lang="en">Disposal, glider, for passenger car</baseName>
            </name>
            <classificationInformation>
                <common:classification>
                    <common:class level="0" classId="2279f95c-4711-3ee2-8393-0e7a7bbfe8d1">transport systems</common:class>
                    <common:class level="1" classId="a68df7d5-0492-3d7e-a949-c23730a59b9f">road</common:class>
                </common:classification>
            </classificationInformation>
            <common:generalComment xml:lang="en">This dataset describes the shredding of the used glider of a passenger car. The entris are given per kg glider. The original data has been collected for the driver of a compact car with a glider weight of approximately 800 kg. Data is based on the e-waste shredding dataset which is based on literature. Infrastructure assumptions for the treatment facility are based on assumptions taken from weee. The output scrap and waste material quantities are derived from the respective glider dataset. The materialization of the glider is divided in 5 main fractions: scrap steel, scrap Aluminium, scrap Copper, scrap plastics and a shredding residue. These are the output waste flows of the process.The details concerning the materialization of the glider trated in this dataset are described in F. Habermacher  "Modeling material inventories and environmental impacts of electric passenger cars", Master Thesis, Department of Environmental Sciences, ETH Zurich, 2011.;
UUID: d0a5ab89-9134-36c5-a56a-bf1f83c204ae</common:generalComment>
        </dataSetInformation>
        <quantitativeReference type="Reference flow(s)">
            <referenceToReferenceFlow>1</referenceToReferenceFlow>
        </quantitativeReference>
        <time xmlns:olca="http://openlca.org/ilcd-extensions" olca:startDate="1388530800000" olca:endDate="1417388400000">
