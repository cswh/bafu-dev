    <processInformation>
        <dataSetInformation>
            <common:UUID>3fd2478c-39bc-4ede-b7e0-4bf086b14d57</common:UUID>
            <name>
                <baseName xml:lang="en">Disposal, ventilation system, various components, m3/h</baseName>
            </name>
            <classificationInformation>
                <common:classification>
                    <common:class level="0" classId="791c965a-a367-3765-af5c-749f3b9a1d40">waste management</common:class>
                    <common:class level="1" classId="593ec29a-698c-369e-be95-7d8b4d0d7ef7">building demolition</common:class>
                </common:classification>
            </classificationInformation>
            <common:generalComment xml:lang="en">Disposal of various components for a ventilation system with a nominal air flow rate of 5'000-20'000 m3/h at the air handling unit. Reference value of inventory is 1 m3/h nominal air flow of the air handling unit (at 2 m/s air speed in cross section of air filter or heat exchanger). The inventory is based on average data of 4 office buildings, 3 schools and 3 residential care homes with a total heated gross floor area of 61719 m2 and a total nominal air flow of 302190 m3/h, specific weight of the components: 0.17 kg/(m3/h), including average components for air valves, air intake, roof-hoods, dampers, fire dampers, silencers and sensors. The data represent a ventilation system mainly made of galvanized steel.</common:generalComment>
        </dataSetInformation>
        <quantitativeReference type="Reference flow(s)">
            <referenceToReferenceFlow>1</referenceToReferenceFlow>
        </quantitativeReference>
        <time xmlns:olca="http://openlca.org/ilcd-extensions" olca:startDate="1388530800000" olca:endDate="1417388400000">
            <common:referenceYear>2014</common:referenceYear>
            <common:dataSetValidUntil>2014</common:dataSetValidUntil>
            <common:timeRepresentativenessDescription xml:lang="en">Amount of material investigated in 2013. Disposal technology mix as used in late 1990ies</common:timeRepresentativenessDescription>
        </time>
        <geography>
            <locationOfOperationSupplyOrProduction location="CH" latitudeAndLongitude="46.798956905893455;8.215353572959305">
                <descriptionOfRestrictions xml:lang="en"> Specific to the technology mix encountered in sorting plants in Switzerland.</descriptionOfRestrictions>
            </locationOfOperationSupplyOrProduction>
        </geography>
        <technology>
            <technologyDescriptionAndIncludedProcesses xml:lang="en">Disposal to a sorting plant assumed. Metal pieces, copper in cables and electronic devices are recycled, plastic parts are incinerated, inert wastes (e.g. rock wool) are landfilled.\n\n# Included processes\nTransport to dismantling facilities, machines for handling in sorting plant, electricity demand for sorting plant, final disposal of waste material. Cut-off to recycling for metals.</technologyDescriptionAndIncludedProcesses>
        </technology>
    </processInformation>
