            <name>
                <baseName xml:lang="en">Ferrochromium, high-carbon, 68% Cr, at regional storage</baseName>
            </name>
            <classificationInformation>
                <common:classification>
                    <common:class level="0" classId="f0795787-0845-3fbd-8c18-b47161a075a4">metals</common:class>
                    <common:class level="1" classId="356b4143-2fd1-3c00-9c0d-55a7c601ae5c">alloys</common:class>
                </common:classification>
            </classificationInformation>
            <common:generalComment xml:lang="en">The module describes the consump-tion of chromite in Europe in 1994. It is designed for the use of chromite as intermediary product in the pro-duction of ferrochromium, dichro-mate and refractories. This module does not consider secondary sources of chromium. Process data is taken mainly from a material flow analysis for the consumption of chromium compounds in Germany. Results are used as a proxy for the European situation. ;
Synonyms: ferro-chrome, ferrochrome, chromeisen; 
UUID: b896d2ec-abc9-3300-9394-10baf6b94365</common:generalComment>
        </dataSetInformation>
        <quantitativeReference type="Reference flow(s)">
            <referenceToReferenceFlow>1</referenceToReferenceFlow>
        </quantitativeReference>
        <time xmlns:olca="http://openlca.org/ilcd-extensions" olca:startDate="757378800000" olca:endDate="1070233200000">
            <common:referenceYear>1994</common:referenceYear>
            <common:dataSetValidUntil>2003</common:dataSetValidUntil>
            <common:timeRepresentativenessDescription xml:lang="en">undefined</common:timeRepresentativenessDescription>
        </time>
        <geography>
            <locationOfOperationSupplyOrProduction location="RER" latitudeAndLongitude="55.895602991909776;28.119894957029818">
                <descriptionOfRestrictions xml:lang="en">This module relates to the consumption in Europe, although the import mix for Germany is chosen. Production relates to a global average.</descriptionOfRestrictions>
            </locationOfOperationSupplyOrProduction>
        </geography>
        <technology>
            <technologyDescriptionAndIncludedProcesses xml:lang="en">Most transport by ship\n\n# Included processes\nThe module includes the transportation of high-carbon ferrochromium to Europe. No secondary production considered, since secondary chromium is recycled to the foundries and has to be inventoried in the respective module, i. e. when casting the final rawmaterial in the stainless steel production.</technologyDescriptionAndIncludedProcesses>
        </technology>
