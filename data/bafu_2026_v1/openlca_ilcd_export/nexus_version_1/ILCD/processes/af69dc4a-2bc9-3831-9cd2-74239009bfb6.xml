            <name>
                <baseName xml:lang="en">Cement mortar, at plant</baseName>
            </name>
            <classificationInformation>
                <common:classification>
                    <common:class level="0" classId="c8cad9b0-1ea3-35b8-8ed7-3f876ce5197a">construction</common:class>
                    <common:class level="1" classId="94d06d0a-b7d7-3c61-9a3e-dbf99b7563c0">binders</common:class>
                </common:classification>
            </classificationInformation>
            <common:generalComment xml:lang="en">The raw materials are mixed in a certain ratio, transported to the packing installation and packed. No direct process emissions are taken into account as they play a subordinate role compared to the emissions of the raw material production (e.g. drying of silica sand) and because no data are available. For inventoring the infrastructure, a yearly production amount of 150'000 tons of an Austrian producer is assumed. The lifespan of the machines is assumed to be 20 years.;
Synonyms: compo; 
UUID: af69dc4a-2bc9-3831-9cd2-74239009bfb6</common:generalComment>
        </dataSetInformation>
        <quantitativeReference type="Reference flow(s)">
            <referenceToReferenceFlow>1</referenceToReferenceFlow>
        </quantitativeReference>
        <time xmlns:olca="http://openlca.org/ilcd-extensions" olca:startDate="946681200000" olca:endDate="975625200000">
