            <name>
                <baseName xml:lang="en">Electricity, medium voltage, production PE, at grid</baseName>
            </name>
            <classificationInformation>
                <common:classification>
                    <common:class level="0" classId="6299429b-5a23-3f58-ba95-d33dc8e1875b">electricity</common:class>
                    <common:class level="1" classId="872b92c1-5e59-3890-9422-f8b70c0cb8a6">production mix</common:class>
                </common:classification>
            </classificationInformation>
            <common:generalComment xml:lang="en">Electricity domestic net production shares are based on annual averages for 2023. Losses are distributed across voltage levels with total losses for the same time frame as well as older proxy data for disaggregation. Electricity trade between countries is not included so the consumption reflects the mix of domestic production and domestic losses. The transmission network and direct emissions to air (SF6-emissions) are also included. Remark: This dataset describes the transmission of medium voltage electricity. Includes underground and overhead lines, as well as air-, vacuum- and SF6-insulated high-to-medium voltage switching stations. Assumptions for transmission network, losses and emissions are based on older UCTE data. UUID: bfd04fa0-2e42-3544-8828-10e44edeb88f</common:generalComment>
        </dataSetInformation>
