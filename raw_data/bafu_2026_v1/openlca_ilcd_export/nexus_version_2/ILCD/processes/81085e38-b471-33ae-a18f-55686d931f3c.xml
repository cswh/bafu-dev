                    <common:class level="3" classId="9af64804-ec61-3831-af66-f8a70034373a">infrastructure</common:class>
                </common:classification>
            </classificationInformation>
            <common:generalComment xml:lang="en">All data is referred to meter*year. Life time of the rail track infrastructure is assumed to be 100 yrs. Inventory for a conventional gravel track bedding. Expenditures due to tunnel construction and bridge construction have been taken into account, according to the share of tunnels and bridges in the Swiss rail network.  All data is referred to a two way track. Allocation between goods and passenger transport is not yet applied;
UUID: 81085e38-b471-33ae-a18f-55686d931f3c</common:generalComment>
        </dataSetInformation>
        <quantitativeReference type="Reference flow(s)">
            <referenceToReferenceFlow>1</referenceToReferenceFlow>
        </quantitativeReference>
        <time xmlns:olca="http://openlca.org/ilcd-extensions" olca:startDate="946681200000" olca:endDate="975625200000">
            <common:referenceYear>2000</common:referenceYear>
            <common:dataSetValidUntil>2000</common:dataSetValidUntil>
            <common:timeRepresentativenessDescription xml:lang="en">Rail length is based on current statistical data (2000). The material consumption represents a situation in the early 1990ties and a recent high speed track in Germany</common:timeRepresentativenessDescription>
        </time>
        <geography>
            <locationOfOperationSupplyOrProduction location="CH" latitudeAndLongitude="46.798956905893455;8.215353572959305">
                <descriptionOfRestrictions xml:lang="en">&lt;null&gt;</descriptionOfRestrictions>
            </locationOfOperationSupplyOrProduction>
        </geography>
        <technology>
            <technologyDescriptionAndIncludedProcesses xml:lang="en">Data represents current technologies\n\n# Included processes\nThe inventory includes the construction of the rail track (track bedding, substructures, catenary system) as well as the construction of tunnels and bridges. Further components of rail track infrastructure, such as signalling infrastructure, train overtaking stations, sound insulation walls and buildings (stations, service garages) are not included in this study. Also land use is not considered, but accounted for in the maintenance and operation, railway track.</technologyDescriptionAndIncludedProcesses>
        </technology>
    </processInformation>
