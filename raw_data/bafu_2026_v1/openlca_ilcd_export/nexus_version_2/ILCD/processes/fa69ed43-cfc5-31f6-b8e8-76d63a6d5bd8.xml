        <geography>
            <locationOfOperationSupplyOrProduction location="CH" latitudeAndLongitude="46.798956905893455;8.215353572959305">
                <descriptionOfRestrictions xml:lang="en">For some exchanges RER- and GLO-modules are used as proxy</descriptionOfRestrictions>
            </locationOfOperationSupplyOrProduction>
        </geography>
        <technology>
            <technologyDescriptionAndIncludedProcesses xml:lang="en">Typical technology for average Swiss production. Mining of boulders by direct separation from rock, whole to whole drilling, kerving wire saw, oxygen lance and water jet. Cutting by wire saw.\n\n# Included processes\nIncludes the raw material granite, the mining, sawing and cooling, the transports within the mine and to the regional storage in Switzerland and the infrastructure (machines). No administration, wastewater, wear and spare parts are included. Dust is accounted for.</technologyDescriptionAndIncludedProcesses>
        </technology>
    </processInformation>
