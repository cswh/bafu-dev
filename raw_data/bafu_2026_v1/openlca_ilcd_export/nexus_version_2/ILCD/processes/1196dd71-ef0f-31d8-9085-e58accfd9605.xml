    <processInformation>
        <dataSetInformation>
            <common:UUID>1196dd71-ef0f-31d8-9085-e58accfd9605</common:UUID>
            <name>
                <baseName xml:lang="en">Ethyl tert-butyl ether, from bioethanol, at plant</baseName>
            </name>
            <classificationInformation>
                <common:classification>
                    <common:class level="0" classId="e70d2ea9-becd-32e6-9944-c946e949f129">fuels</common:class>
                    <common:class level="1" classId="a23223d7-82cf-3a02-91f2-99c6cf539bd3">biofuels</common:class>
                </common:classification>
            </classificationInformation>
            <common:generalComment xml:lang="en">Inventory refers to the production of 1 kg ETBE, at the oil refinery. ETBE can be incorporated at up to 15% vol. in gasoline, as an oxygenate, according to the current (2005) European Norms. Anhydrous bioethanol is produced from rye, in the RER context. Naphtha is used as a proxy dataset for isobutene. This process is applied in France and Spain and possibly in Germany. Fossil and biogenic carbon contents are respectively 45.4% and 25.4%, according to the respective shares of isobutene (53% wt.) and ethanol (47% wt.).;
CAS number: 000637-92-3; 
Formula: C6H14O; 
Synonyms: 2-ethoxy-2-methylpropane, 2-methyl-2-ethoxypropane, ETBE, ethyl tert-butyl ether, ethyl tertiary butyl ether, ethyl tertio butyl ether, ethyl tert-butyl oxide, tert-butyl ethyl ether; 
UUID: 1196dd71-ef0f-31d8-9085-e58accfd9605</common:generalComment>
        </dataSetInformation>
        <quantitativeReference type="Reference flow(s)">
            <referenceToReferenceFlow>1</referenceToReferenceFlow>
        </quantitativeReference>
        <time xmlns:olca="http://openlca.org/ilcd-extensions" olca:startDate="946681200000" olca:endDate="975625200000">
