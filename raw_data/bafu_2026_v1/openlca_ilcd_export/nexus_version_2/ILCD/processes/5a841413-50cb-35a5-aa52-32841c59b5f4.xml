            <name>
                <baseName xml:lang="en">Polystyrene, extruded (XPS), HFC-134a blown, at plant</baseName>
            </name>
            <classificationInformation>
                <common:classification>
                    <common:class level="0" classId="c8cad9b0-1ea3-35b8-8ed7-3f876ce5197a">construction</common:class>
                    <common:class level="1" classId="1acdad44-67d7-38ae-84d0-661babb7367c">insulation</common:class>
                </common:classification>
            </classificationInformation>
            <common:generalComment xml:lang="en">This dataset can be used in the construction building sector. The cutting of the extruded polystyrene blocks is not included in the process. Blowing agent is HFC-134a. Process emissions are 20% (w/w);
Synonyms: XPS; 
UUID: 5a841413-50cb-35a5-aa52-32841c59b5f4</common:generalComment>
        </dataSetInformation>
        <quantitativeReference type="Reference flow(s)">
            <referenceToReferenceFlow>1</referenceToReferenceFlow>
        </quantitativeReference>
        <time xmlns:olca="http://openlca.org/ilcd-extensions" olca:startDate="757378800000" olca:endDate="1164927600000">
            <common:referenceYear>1994</common:referenceYear>
            <common:dataSetValidUntil>2006</common:dataSetValidUntil>
            <common:timeRepresentativenessDescription xml:lang="en">Technology in 1994 was still using CFC or HCFC as blowing agent. In 2005, already more than 50% of companies in Europe are using CO2 as blowing agent. Though mainly in the USA, HFC-134a and HFC-152a as a blowing agent are still common.</common:timeRepresentativenessDescription>
        </time>
        <geography>
            <locationOfOperationSupplyOrProduction location="RER" latitudeAndLongitude="55.895602991909776;28.119894957029818">
                <descriptionOfRestrictions xml:lang="en">&lt;null&gt;</descriptionOfRestrictions>
            </locationOfOperationSupplyOrProduction>
        </geography>
        <technology>
            <technologyDescriptionAndIncludedProcesses xml:lang="en">Extrusion process of expandable polystyrene including discharge via slot die. HCF-134a as blowing agents.\n\n# Included processes\nThe dataset describes the production of extruded polystyrene. Included processes are the melting of polystyrene pearls in the extruder, the discharge through a slot die, as well as the cooling with water.</technologyDescriptionAndIncludedProcesses>
        </technology>
    </processInformation>
