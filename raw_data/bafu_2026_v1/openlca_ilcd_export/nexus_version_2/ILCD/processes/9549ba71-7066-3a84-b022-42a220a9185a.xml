    <processInformation>
        <dataSetInformation>
            <common:UUID>9549ba71-7066-3a84-b022-42a220a9185a</common:UUID>
            <name>
                <baseName xml:lang="en">Ferrochromium, high-carbon, 68% Cr, at plant</baseName>
            </name>
            <classificationInformation>
                <common:classification>
                    <common:class level="0" classId="f0795787-0845-3fbd-8c18-b47161a075a4">metals</common:class>
                    <common:class level="1" classId="356b4143-2fd1-3c00-9c0d-55a7c601ae5c">alloys</common:class>
                </common:classification>
            </classificationInformation>
            <common:generalComment xml:lang="en">The module describes the production of chromite in 1994 for a world-wide production average. It is designed for the use of chromite as intermediary product in the production of ferrochromium, dichromate and refractories. This module does not consider secondary sources of chromium. Process data is taken mainly from a material flow analysis for the con-sumption of chromium compounds in Germany. Results are used as a proxy for the European situation.;
Synonyms: ferro-chrome, ferrochrome, chromeisen; 
UUID: 9549ba71-7066-3a84-b022-42a220a9185a</common:generalComment>
        </dataSetInformation>
        <quantitativeReference type="Reference flow(s)">
            <referenceToReferenceFlow>1</referenceToReferenceFlow>
        </quantitativeReference>
        <time xmlns:olca="http://openlca.org/ilcd-extensions" olca:startDate="725842800000" olca:endDate="817772400000">
            <common:referenceYear>1993</common:referenceYear>
            <common:dataSetValidUntil>1995</common:dataSetValidUntil>
            <common:timeRepresentativenessDescription xml:lang="en">undefined</common:timeRepresentativenessDescription>
        </time>
        <geography>
            <locationOfOperationSupplyOrProduction location="GLO">
                <descriptionOfRestrictions xml:lang="en">This module relates to the world wide production situation. Some  Processes originate from data sets valid for Switzerland or Europe.</descriptionOfRestrictions>
            </locationOfOperationSupplyOrProduction>
        </geography>
        <technology>
            <technologyDescriptionAndIncludedProcesses xml:lang="en">Direct reduction of chromite ores with carbon in three-phase submerged arc furnaces. 50% ordinar technology, 50% new processes like Outokumpu, Showa Denko, Krupp-CODIR &amp; plasma furnace.\n\n# Included processes\nThe module includes the pre-treatment of the ore and the reduction to high-carbon ferrochromium. No secondary production considered, since secondary chromium is recycled to the foundries and has to be inventoried in the respective module, i.e. when casting the final raw material in the stainless steel production.</technologyDescriptionAndIncludedProcesses>
        </technology>
    </processInformation>
