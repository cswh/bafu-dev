            <name>
                <baseName xml:lang="en">Capacitor, Tantalum-, through-hole mounting, at plant</baseName>
            </name>
            <classificationInformation>
                <common:classification>
                    <common:class level="0" classId="57aded3d-4d3f-3d65-b03a-7392ab36aef2">electronics</common:class>
                    <common:class level="1" classId="6086e8b4-40cc-356e-837f-debbd03b1a27">component</common:class>
                </common:classification>
            </classificationInformation>
            <common:generalComment xml:lang="en">The data represent a tantalum-capacitor for the hole-through mounting technology, used in the information and communication technology. Material data are taken from datasheets of producers of such capacitors. Infrastructure and production efforts are based on own assumptions. The dataset represents 1 kg of capacitors with a weight of 0.254 gram/unit. In 2023, only production efforts data are updated, which are explained in separate modules. Furthermore, material and energy input are now represented by global inventory flows; UUID: a5367a2d-a9cb-3ea2-8a00-0b2fede0ebcb</common:generalComment>
        </dataSetInformation>
        <quantitativeReference type="Reference flow(s)">
            <referenceToReferenceFlow>1</referenceToReferenceFlow>
        </quantitativeReference>
        <time xmlns:olca="http://openlca.org/ilcd-extensions" olca:startDate="1672527600000" olca:endDate="1890774000000">
