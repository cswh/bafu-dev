            <name>
                <baseName xml:lang="en">Lithium carbonate, at plant</baseName>
            </name>
            <classificationInformation>
                <common:classification>
                    <common:class level="0" classId="c3652903-5cc5-3b77-aabb-625d30a0937f">chemicals</common:class>
                    <common:class level="1" classId="4fe30688-3bb7-3dc0-8f13-9174c7cc7622">inorganic</common:class>
                </common:classification>
            </classificationInformation>
            <common:generalComment xml:lang="en">The dataset can be used for preparing electrode base material for batteries. Data are based on an environmental survey from SEIA-CONAMA (2006). Infrastructure: ecoinvent dataset "chemical plant, organics" is accounted. Transportation efforts are calculated in detail, based on the environmental survey.The plant uses liquified gas. Liquified gas is not available as "heat…" or "burned…" .  Thus we balanced more "natural gas, burned..." and made a credit for preparation of "natural gas, high pressure". ;
CAS number: 000554-13-2; 
Formula: Li2CO3; 
Synonyms: Li2CO3; 
UUID: 2f4a8d1a-d27a-39c5-9370-8a2776ec7326</common:generalComment>
        </dataSetInformation>
        <quantitativeReference type="Reference flow(s)">
            <referenceToReferenceFlow>1</referenceToReferenceFlow>
        </quantitativeReference>
        <time xmlns:olca="http://openlca.org/ilcd-extensions" olca:startDate="946681200000" olca:endDate="1164927600000">
