            <name>
                <baseName xml:lang="en">Autoclaved aerated concrete block, at plant</baseName>
            </name>
            <classificationInformation>
                <common:classification>
                    <common:class level="0" classId="c8cad9b0-1ea3-35b8-8ed7-3f876ce5197a">construction</common:class>
                    <common:class level="1" classId="63c78828-3070-3f8e-8398-985f63ad5058">concrete</common:class>
                </common:classification>
            </classificationInformation>
            <common:generalComment xml:lang="en">Hardening is assumed to be by air-drying. It is assumed that there is wastewater and solid waste, but as no exact description on the composition of the wastewater and solid waste is available a proxy for each ("treatment, concrete production effluent, to wastewater treatment, class 3" and "disposal, municipal solid waste, 22.9% water, to municipal incineration") is used. The lifespan of the plant is assumed to be 50 years.;
Synonyms: Bimshohlblockstein, Ytong; 
UUID: 86015fcf-0270-3f66-b705-ee531fe5f3ae</common:generalComment>
        </dataSetInformation>
