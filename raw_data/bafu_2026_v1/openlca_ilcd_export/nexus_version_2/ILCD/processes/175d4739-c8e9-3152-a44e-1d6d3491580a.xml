            <name>
                <baseName xml:lang="en">CD-ROM, DVD-ROM drive, laptop computer, at plant</baseName>
            </name>
            <classificationInformation>
                <common:classification>
                    <common:class level="0" classId="57aded3d-4d3f-3d65-b03a-7392ab36aef2">electronics</common:class>
                    <common:class level="1" classId="296c829f-9160-371d-9441-529c080d79d5">devices</common:class>
                    <common:class level="2" classId="658b1079-65ad-3243-869e-69888b514fd6">module</common:class>
                    <common:class level="3" classId="6d5d72c6-3d65-337f-a409-8c5a740a1361">component</common:class>
                </common:classification>
            </classificationInformation>
            <common:generalComment xml:lang="en">This dataset can be applied to describe the production of a common CD/DVD-ROM drive in the last 3 years before the reference year 2005 (IDE drive, total weight 0.249 kg). The dataset includes material information for all the major CD/DVD-ROM drive components (covers, printed wiring board, optical reader, motor(s), tray, etc.). The information is mainly based on one dissertation work plus CD/DVD-ROM drive specific data provided by leading optical drive manufacturers (Toshiba, Teac, HP). Data for the desktop CD/DVD-ROM drive have been extrapolated to the lighter laptop CD/DVD-ROM drive by specific calculation setups. ;
UUID: 175d4739-c8e9-3152-a44e-1d6d3491580a</common:generalComment>
        </dataSetInformation>
        <quantitativeReference type="Reference flow(s)">
            <referenceToReferenceFlow>1</referenceToReferenceFlow>
        </quantitativeReference>
        <time xmlns:olca="http://openlca.org/ilcd-extensions" olca:startDate="1072911600000" olca:endDate="1101855600000">
            <common:referenceYear>2004</common:referenceYear>
            <common:dataSetValidUntil>2004</common:dataSetValidUntil>
            <common:timeRepresentativenessDescription xml:lang="en">undefined</common:timeRepresentativenessDescription>
        </time>
        <geography>
            <locationOfOperationSupplyOrProduction location="GLO">
                <descriptionOfRestrictions xml:lang="en">A CD/DVD-ROM drive may be assembled anywhere in the world.</descriptionOfRestrictions>
            </locationOfOperationSupplyOrProduction>
        </geography>
        <technology>
            <technologyDescriptionAndIncludedProcesses xml:lang="en">The production of a CD/DVD-ROM drive for a laptop computer includes the metal processing steps rolling, cutting and section bar extrusion. Plastic parts are blow moulded or extruded into required shapes.\n\n# Included processes\nDescribes the production of a CD-ROM/DVD-ROM drive for a desktop computer. Calculated per 1 produced CD/DVD-ROM drive (1 unit). Included are the materials (mainly metals and plastics) with their respective manufacturing processes (e.g. sheet rolling or blow moulding). Further inventoried is the infrastructure (factory), the electricity for the assembly of the CD/DVD-ROM drive, the respective waste heat, and the required rail and road transport for input materials from the regional storage to the factory. Not included are emissions to air and water (negligible), the heating of the facility, scrap materials (recycled and reused), the packaging, as well as the post consumer disposal, which is attributed to the desktop computer as a whole.</technologyDescriptionAndIncludedProcesses>
        </technology>
    </processInformation>
