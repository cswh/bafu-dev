    <processInformation>
        <dataSetInformation>
            <common:UUID>62698e20-cc0e-4926-b549-73a47a009d0e</common:UUID>
            <name>
                <baseName xml:lang="en">Disposal, ventilation system for appartment buildings, steel ducts, without GHE</baseName>
            </name>
            <classificationInformation>
                <common:classification>
                    <common:class level="0" classId="791c965a-a367-3765-af5c-749f3b9a1d40">waste management</common:class>
                    <common:class level="1" classId="593ec29a-698c-369e-be95-7d8b4d0d7ef7">building demolition</common:class>
                </common:classification>
            </classificationInformation>
            <common:generalComment xml:lang="en">Disposal of a ventilation system for an appartment building with a specific air flow rate of 0.92 m3/h per m2 heated gross floor area. The reference value of the inventory is 1 m2 heated gross floor area. The inventory is based on a study of an appartment building with 6 flats, a heated gross floor area of 780 m2 and a total nominal air flow of 720 m3/h. The inventory includes an average of decentral and central systems. It includes average components for air handling units, ducts (including 30mm thermal insulation where needed), air valves, roof-hoods, dampers and silencers. No insuation for fire protection or fire dampers included. The data represent a ductwork mainly made of galvanized steel and includes compact air handling units with cross plate heat excangers as heat recovery and a nominal air flow rate of 200-1200 m3/h per unit. No ground heat exchanger, ventilation of side rooms, cellars or car parks are included.;
UUID: 62698e20-cc0e-4926-b549-73a47a009d0e</common:generalComment>
        </dataSetInformation>
        <quantitativeReference type="Reference flow(s)">
            <referenceToReferenceFlow>1</referenceToReferenceFlow>
        </quantitativeReference>
        <time xmlns:olca="http://openlca.org/ilcd-extensions" olca:startDate="757378800000" olca:endDate="1228086000000">
            <common:referenceYear>1994</common:referenceYear>
            <common:dataSetValidUntil>2008</common:dataSetValidUntil>
            <common:timeRepresentativenessDescription xml:lang="en">Amount of material investigated in 2003. Process information partly from 2008. Disposal technology mix as used in late 1990ies</common:timeRepresentativenessDescription>
        </time>
        <geography>
            <locationOfOperationSupplyOrProduction location="CH" latitudeAndLongitude="46.798956905893455;8.215353572959305">
                <descriptionOfRestrictions xml:lang="en">Specific to the technology mix encountered in sorting plants in Switzerland.</descriptionOfRestrictions>
            </locationOfOperationSupplyOrProduction>
        </geography>
        <technology>
            <technologyDescriptionAndIncludedProcesses xml:lang="en">Disposal to a sorting plant assumed. Metal pieces, copper in cables and electronic devices are recycled, plastic parts are incinerated, inert wastes (e.g. rock wool) are landfilled.\n\n# Included processes\nTransport to dismantling facilities, machines for handling in sorting plant, electricity demand for sorting plant, final disposal of waste material. Cut-off to recycling for metals.</technologyDescriptionAndIncludedProcesses>
        </technology>
    </processInformation>
