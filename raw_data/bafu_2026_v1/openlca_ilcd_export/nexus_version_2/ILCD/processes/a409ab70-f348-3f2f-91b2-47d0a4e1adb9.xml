            <name>
                <baseName xml:lang="en">Flat glass, coated, at plant</baseName>
            </name>
            <classificationInformation>
                <common:classification>
                    <common:class level="0" classId="57808913-8b3c-3885-b6a6-1f93de0428f5">glass</common:class>
                    <common:class level="1" classId="83c52226-a009-3307-90cb-8bf4959a17fe">construction</common:class>
                </common:classification>
            </classificationInformation>
            <common:generalComment xml:lang="en">All data are based on the environmental report of the company "Interpane" (DE) for the year 2000. The Targets used for sputtering are bismuth, silver and nickel-chromium. Only nickel-chromium is modelled for missing silver and bismuth modules in the database.;
Synonyms: sputtering, bedampfen, plate, sputtern, Kathodenzerstäubung, Vergütungsschicht, Wärmeschutzschicht; 
UUID: a409ab70-f348-3f2f-91b2-47d0a4e1adb9</common:generalComment>
        </dataSetInformation>
