                    <common:class level="0" classId="eee9def9-2b96-3519-a89d-a743e30ff2a5">minerals</common:class>
                    <common:class level="1" classId="1b006231-a841-3bb5-9b55-0056a2d9ab52">unspecified</common:class>
                </common:classification>
            </classificationInformation>
            <common:generalComment xml:lang="en">The module describes the produc-tion of chromite in 1994 for a world-wide production average. It is de-signed for the use of chromite as intermediary product in the produc-tion of ferrochromium, dichromate and refractories. Process data is taken mainly from d a material flow analysis for the consumption of chromium compounds in Germany. The ore concentrate produced has a content of 30.7% Cr (44.9% Cr2O3) by weight.;
CAS number: 053293-42-8; 
Synonyms: chromeisenstein; 
UUID: cc5a0e54-4eb4-38b9-90c3-b5ed7f56a8fb</common:generalComment>
        </dataSetInformation>
