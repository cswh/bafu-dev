            <name>
                <baseName xml:lang="en">Foam glass, at plant</baseName>
            </name>
            <classificationInformation>
                <common:classification>
                    <common:class level="0" classId="c8cad9b0-1ea3-35b8-8ed7-3f876ce5197a">construction</common:class>
                    <common:class level="1" classId="1acdad44-67d7-38ae-84d0-661babb7367c">insulation</common:class>
                </common:classification>
            </classificationInformation>
            <common:generalComment xml:lang="en">Refers to foam glass of a density of 110 kg/m3 and a thermal conductivity of 0.040 W/mK. Foam glass products sold to Switzerland and Lichtenstein are produced with renewable energy certificates from RECS (www.recs.org). ;
Synonyms: T4 WDS; 
UUID: de6ba86b-50ab-3ab2-8208-6c112921a8f8</common:generalComment>
        </dataSetInformation>
        <quantitativeReference type="Reference flow(s)">
            <referenceToReferenceFlow>1</referenceToReferenceFlow>
        </quantitativeReference>
        <time xmlns:olca="http://openlca.org/ilcd-extensions" olca:startDate="978303600000" olca:endDate="1007161200000">
