        <dataSetInformation>
            <common:UUID>4f96fd19-e24d-3747-8d23-d3db976337ab</common:UUID>
            <name>
                <baseName xml:lang="en">Electricity, hydropower, at pumped storage power plant</baseName>
            </name>
            <classificationInformation>
                <common:classification>
                    <common:class level="0" classId="a7a7aa24-604f-3bc6-a698-545bafdf915d">electricity by fuel</common:class>
                    <common:class level="1" classId="6f11c2d0-4f16-3031-9733-444055c70cb9">hydro</common:class>
                    <common:class level="2" classId="610ea876-d7ca-3715-9be6-4210eb1377ad">pumping storage</common:class>
                </common:classification>
            </classificationInformation>
            <common:generalComment xml:lang="en">This study adresses Swiss dams only. The data have been applied for an extrapolation to preliminary describe dam-mixes in non-alpine countries. Considering the difficulty to clearly seperate within the Swiss dams system for some of the dams function for normal electricity generation from pumping storage, the same basic information has been used for the modules describing the two functions. A representative sample of Swiss dams with a height of more than 30 metres is taken into account for calculating the numbers. Lifetime is assumed to be 150 years. The efficiency of the pumps is assumed to be 70%. The results of this module cannot be applied to describe a single unit.;
UUID: 4f96fd19-e24d-3747-8d23-d3db976337ab</common:generalComment>
        </dataSetInformation>
        <quantitativeReference type="Reference flow(s)">
            <referenceToReferenceFlow>1</referenceToReferenceFlow>
        </quantitativeReference>
        <time xmlns:olca="http://openlca.org/ilcd-extensions" olca:startDate="-788922000000" olca:endDate="975625200000">
