            <name>
                <baseName xml:lang="en">HDD, desktop computer, at plant</baseName>
            </name>
            <classificationInformation>
                <common:classification>
                    <common:class level="0" classId="57aded3d-4d3f-3d65-b03a-7392ab36aef2">electronics</common:class>
                    <common:class level="1" classId="6086e8b4-40cc-356e-837f-debbd03b1a27">component</common:class>
                </common:classification>
            </classificationInformation>
            <common:generalComment xml:lang="en">After 2023 updates, this dataset can be applied to describe the production of a common hard disk drive in the reference year 2022 (Model "Western Digital", IDE hard drive 3.5 inch, 1 TB, total weight 0.45 kg). New composition is gathered from JRC technical reports and manufacturer's product sheet. The dataset includes material information for all the major hard disk drive components (covers, printed wiring board, circular plates (platters), pointer assembly, etc.). The information is mainly based on one dissertation work plus desktop-specific data provided by a leading HDD manufacturer.; UUID: 115073e1-db4d-3bfe-a137-8dcfb83263c2</common:generalComment>
        </dataSetInformation>
        <quantitativeReference type="Reference flow(s)">
            <referenceToReferenceFlow>1</referenceToReferenceFlow>
        </quantitativeReference>
        <time xmlns:olca="http://openlca.org/ilcd-extensions" olca:startDate="1672527600000" olca:endDate="1890774000000">
            <common:referenceYear>2023</common:referenceYear>
            <common:dataSetValidUntil>2029</common:dataSetValidUntil>
            <common:timeRepresentativenessDescription xml:lang="en">Unspecified</common:timeRepresentativenessDescription>
        </time>
        <geography>
            <locationOfOperationSupplyOrProduction location="GLO">
                <descriptionOfRestrictions xml:lang="en">A computer hard disk drive may be assembled anywhere in the world.</descriptionOfRestrictions>
            </locationOfOperationSupplyOrProduction>
        </geography>
        <technology>
            <technologyDescriptionAndIncludedProcesses xml:lang="en">The production of a hard disk drive for a desktop computer includes the metal processing steps rolling, cutting, section bar extrusion and coating. Plastic parts are blow moulded or extruded into required shapes.\n\n# Included processes\nDescribes the production of a hard disk drive for a desktop computer. Calculated per 1 produced hard disk (1 unit). Included are the materials (mainly metals and plastics) with their respective manufacturing processes (e.g. sheet rolling or blow moulding). Further inventoried is the infrastructure (factory), the electricity for the assembly of the hard disk drive, the respective waste heat, and the required rail and road transport for input materials from the regional storage to the factory. Not included are emissions to air and water (negligible), the heating of the facility, scrap materials (recycled and reused), the packaging, as well as the disposal, which is attributed to the desktop computer as a whole.</technologyDescriptionAndIncludedProcesses>
        </technology>
    </processInformation>
