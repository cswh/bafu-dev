    <processInformation>
        <dataSetInformation>
            <common:UUID>e9d3e6de-15d4-379c-99d8-40155ad01fca</common:UUID>
            <name>
                <baseName xml:lang="en">Ferromanganese, high-coal, 74.5% Mn, at regional storage</baseName>
            </name>
            <classificationInformation>
                <common:classification>
                    <common:class level="0" classId="f0795787-0845-3fbd-8c18-b47161a075a4">metals</common:class>
                    <common:class level="1" classId="356b4143-2fd1-3c00-9c0d-55a7c601ae5c">alloys</common:class>
                </common:classification>
            </classificationInformation>
            <common:generalComment xml:lang="en">The module describes the consumption of ferromanganese in Europe in 1995. It is designed for the use of the metal as alloying element. This module does not consider secondary sources of manganese. Process data is taken mainly from a material flow analysis for the consumption of chromium in Germany. Results are used as a proxy for the European situation. This module may be used as proxy for the silicomanganese production;
UUID: e9d3e6de-15d4-379c-99d8-40155ad01fca</common:generalComment>
        </dataSetInformation>
        <quantitativeReference type="Reference flow(s)">
            <referenceToReferenceFlow>1</referenceToReferenceFlow>
        </quantitativeReference>
        <time xmlns:olca="http://openlca.org/ilcd-extensions" olca:startDate="757378800000" olca:endDate="1070233200000">
            <common:referenceYear>1994</common:referenceYear>
            <common:dataSetValidUntil>2003</common:dataSetValidUntil>
            <common:timeRepresentativenessDescription xml:lang="en">undefined</common:timeRepresentativenessDescription>
        </time>
        <geography>
            <locationOfOperationSupplyOrProduction location="RER" latitudeAndLongitude="55.895602991909776;28.119894957029818">
                <descriptionOfRestrictions xml:lang="en">This module relates to the consumption in Europe, although the import mix for Germany is chosen.</descriptionOfRestrictions>
            </locationOfOperationSupplyOrProduction>
        </geography>
        <technology>
            <technologyDescriptionAndIncludedProcesses xml:lang="en">The ore is processed in blast furnaces (20%), electric arc furnaces without flux (27%), electric arc furnaces with calcareous flux (53%).\n\n# Included processes\nThe module includes the reduction to high-carbon ferromanganese. No secondary production considered, since secondary manganese is recycled to the foundries and has to be inventoried in the respective module, i. e. when casting the final rawmaterial in the steel production.</technologyDescriptionAndIncludedProcesses>
        </technology>
    </processInformation>
