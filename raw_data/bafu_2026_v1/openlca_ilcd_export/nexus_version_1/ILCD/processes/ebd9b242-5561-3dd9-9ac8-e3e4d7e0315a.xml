            <name>
                <baseName xml:lang="en">Trimethylamine, at plant</baseName>
            </name>
            <classificationInformation>
                <common:classification>
                    <common:class level="0" classId="c3652903-5cc5-3b77-aabb-625d30a0937f">chemicals</common:class>
                    <common:class level="1" classId="9a72f982-b774-3c52-bdbf-6125c825c85b">organic</common:class>
                </common:classification>
            </classificationInformation>
            <common:generalComment xml:lang="en">The functional unit represent 1 kg of anhydrous trimethylamine.  Trimethylamine is produced commercially together with di-methylamine and mono-methylamine. Due to the stoechiometric calculation of the data in this inventory only trimethylamine was considerd as product. Large uncertainty on the process emissions due to missing data.;
CAS number: 000075-50-3; 
Formula: C3H9N; 
Synonyms: TMA, N,N-dimethylmethamine, N,N-dimethylmethanamine; 
UUID: ebd9b242-5561-3dd9-9ac8-e3e4d7e0315a</common:generalComment>
        </dataSetInformation>
        <quantitativeReference type="Reference flow(s)">
            <referenceToReferenceFlow>1</referenceToReferenceFlow>
        </quantitativeReference>
        <time xmlns:olca="http://openlca.org/ilcd-extensions" olca:startDate="946681200000" olca:endDate="975625200000">
            <common:referenceYear>2000</common:referenceYear>
            <common:dataSetValidUntil>2000</common:dataSetValidUntil>
            <common:timeRepresentativenessDescription xml:lang="en">Time of literature publication. Main process information source from 1979.</common:timeRepresentativenessDescription>
        </time>
        <geography>
            <locationOfOperationSupplyOrProduction location="RER" latitudeAndLongitude="55.895602991909776;28.119894957029818">
                <descriptionOfRestrictions xml:lang="en">&lt;null&gt;</descriptionOfRestrictions>
            </locationOfOperationSupplyOrProduction>
        </geography>
        <technology>
            <technologyDescriptionAndIncludedProcesses xml:lang="en">Production from vaporised methanol and ammonia with a process yield of 95%. After the process reaction excess ammonia and amine is recycled amine and trimethylamine is recovered in a distilling column. The inventory bases on stoechiometric calculations. The emissions to air (0.2 wt.% of raw material input) and water were estimated using mass balance. Treatment of the waste water in a internal waste water treatment plant assumed (elimination efficiency of 90% for C, 70% for NH4-N and 50% for N-tot). The used reaction catalysts in the process (aluminium silicate or phosphate) were neglected.\n\n# Included processes\nRaw materials and chemicals used for production, transport of materials to manufacturing plant, estimated emissions to air and water from production (incomplete), estimation of enegry demand and infrastructure of the plant (approximation). Solid wastes (as e.g. catalysts) omitted.</technologyDescriptionAndIncludedProcesses>
        </technology>
    </processInformation>
