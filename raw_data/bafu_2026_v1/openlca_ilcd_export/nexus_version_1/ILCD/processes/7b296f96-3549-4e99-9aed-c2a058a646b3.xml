            <name>
                <baseName xml:lang="en">Disposal, exhaust air system for kitchen and bathroom in appartment buildings</baseName>
            </name>
            <classificationInformation>
                <common:classification>
                    <common:class level="0" classId="791c965a-a367-3765-af5c-749f3b9a1d40">waste management</common:class>
                    <common:class level="1" classId="593ec29a-698c-369e-be95-7d8b4d0d7ef7">building demolition</common:class>
                </common:classification>
            </classificationInformation>
            <common:generalComment xml:lang="en">Disposal of a exhaust air system for kitchen and bathroom in appartment buildings. The reference value of the inventory is 1 m2 heated gross floor area. The inventory is based on a study of one large appartment building with a heated gross floor area of 30800 m2.The inventory includes materials needed for fans, ducts, insulations and silencers. The data represents ductwork mainly made of galvanized steel. It includes duct fans and radial fans without heat recovery and a nominal air flow rate of 100-5700 m3/h per unit.;
UUID: 7b296f96-3549-4e99-9aed-c2a058a646b3</common:generalComment>
        </dataSetInformation>
        <quantitativeReference type="Reference flow(s)">
            <referenceToReferenceFlow>1</referenceToReferenceFlow>
        </quantitativeReference>
        <time xmlns:olca="http://openlca.org/ilcd-extensions" olca:startDate="757378800000" olca:endDate="1228086000000">
            <common:referenceYear>1994</common:referenceYear>
            <common:dataSetValidUntil>2008</common:dataSetValidUntil>
            <common:timeRepresentativenessDescription xml:lang="en">Amount of material investigated in 1998. Process information partly from 1998 to 2008. Disposal technology mix as used in late 1990ies</common:timeRepresentativenessDescription>
        </time>
        <geography>
            <locationOfOperationSupplyOrProduction location="CH" latitudeAndLongitude="46.798956905893455;8.215353572959305">
                <descriptionOfRestrictions xml:lang="en">Specific to the technology mix encountered in sorting plants in Switzerland.</descriptionOfRestrictions>
            </locationOfOperationSupplyOrProduction>
        </geography>
        <technology>
            <technologyDescriptionAndIncludedProcesses xml:lang="en">Cut-off to recycling for all metals, disposal to a sorting plant for other materials assumed. plastic parts are incinerated, inert wastes (e.g. rock wool) are landfilled.\n\n# Included processes\nMetals not included (Cut-off to recycling). For other materials: transport to dismantling facilities, machines for handling in sorting plant, electricity demand for sorting plant, final disposal of waste material.</technologyDescriptionAndIncludedProcesses>
        </technology>
    </processInformation>
