            </classificationInformation>
            <common:generalComment xml:lang="en">This dataset can be applied to describe the production of a typical laptop computer in the last 3 years before the reference year 2010s (Intel® Celeron® M, 4 GB RAM, 500 GB HDD, 15.4 inch screen, total weight with expansion base  2.77 kg; UUID: 9d632221-4822-3b69-b3b4-125374d32853</common:generalComment>
        </dataSetInformation>
        <quantitativeReference type="Reference flow(s)">
            <referenceToReferenceFlow>1</referenceToReferenceFlow>
        </quantitativeReference>
        <time xmlns:olca="http://openlca.org/ilcd-extensions" olca:startDate="1672527600000" olca:endDate="1890774000000">
