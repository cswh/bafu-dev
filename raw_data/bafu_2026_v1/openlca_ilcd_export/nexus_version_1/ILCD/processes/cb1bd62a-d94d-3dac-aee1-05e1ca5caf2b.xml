        <dataSetInformation>
            <common:UUID>cb1bd62a-d94d-3dac-aee1-05e1ca5caf2b</common:UUID>
            <name>
                <baseName xml:lang="en">Platinum, secondary, at refinery</baseName>
            </name>
            <classificationInformation>
                <common:classification>
                    <common:class level="0" classId="f0795787-0845-3fbd-8c18-b47161a075a4">metals</common:class>
                    <common:class level="1" classId="b0affdc1-1e4f-313d-87ed-6b9561e850d5">non ferro</common:class>
                </common:classification>
            </classificationInformation>
            <common:generalComment xml:lang="en">This module describes the collecting of autocatalysts in Germany, the dismantling of the catalysts and the pyrometallurgical processing followed by a hydrometallurgical purification step. The multioutput-process "platinum group metal production, secondary, RER" delivers the co-products "platinum, secondary, at refinery", "palladium, secondary, at refinery" and "rhodium, secondary, at refinery". The smelter slag disposal is inventoried as disposal of inert material, thus neglecting potentially important (but unknown) heavy metal emissions.;
UUID: cb1bd62a-d94d-3dac-aee1-05e1ca5caf2b</common:generalComment>
        </dataSetInformation>
        <quantitativeReference type="Reference flow(s)">
            <referenceToReferenceFlow>1</referenceToReferenceFlow>
        </quantitativeReference>
        <time xmlns:olca="http://openlca.org/ilcd-extensions" olca:startDate="946681200000" olca:endDate="975625200000">
